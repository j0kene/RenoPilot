# Model backend per role: "claude_cli" (default while building) or "openai"
# RENOPILOT_BACKEND=claude_cli

# claude_cli model aliases per role (sonnet | haiku | opus | full model id)
# RENOPILOT_MODEL_VISION=sonnet
# RENOPILOT_MODEL_PLANNER=sonnet
# RENOPILOT_MODEL_RERANK=haiku
# RENOPILOT_MODEL_INTAKE=haiku

# Only needed after the switch to OpenAI
# OPENAI_API_KEY=

# Embedding model for catalog search (open_clip name:pretrained)
# RENOPILOT_EMBED_MODEL=ViT-B-16-SigLIP:webli

# Set to 1 to let pytest run tests that call the real model
# RENOPILOT_LIVE=0
