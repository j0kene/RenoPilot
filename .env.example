# RenoPilot: ONE env file, read by the app and by docker-compose.yml (Langfuse).
#   cp .env.example .env          (Windows: copy .env.example .env)

# ---------------------------------------------------------------- model access (live mode)
# An existing Claude Code login works; otherwise give the CLI one of these.
# CLAUDE_CODE_OAUTH_TOKEN=        # run `claude setup-token` once (uses your Claude subscription)
# ANTHROPIC_API_KEY=              # or an API key (billed per token)

# Model backend for all roles: claude_cli (default) or openai
# RENOPILOT_BACKEND=claude_cli
# RENOPILOT_EFFORT=                # claude_cli: low|medium|high|... (blank = model default)
# OPENAI_API_KEY=                 # only for RENOPILOT_BACKEND=openai

# claude_cli model aliases per role (sonnet | haiku | opus | full model id)
# RENOPILOT_MODEL_VISION=sonnet
# RENOPILOT_MODEL_PLANNER=sonnet
# RENOPILOT_MODEL_RERANK=haiku
# RENOPILOT_MODEL_SHOPPER=sonnet
# RENOPILOT_MODEL_INTAKE=haiku

# How the shortlist picks products: react (a shopper agent per item type, with catalog tools) | rerank (one call)
# RENOPILOT_PICKER=react

# Embedding model for catalog search (open_clip name:pretrained)
# RENOPILOT_EMBED_MODEL=ViT-B-16-SigLIP:webli

# ---------------------------------------------------------------- Langfuse (traces)
# `docker compose up` runs Langfuse and creates its project with THESE keys on first start, so the
# app and the server always agree. Comment them out to turn tracing off (e.g. without Langfuse running).
LANGFUSE_PUBLIC_KEY=pk-lf-renopilot-local
LANGFUSE_SECRET_KEY=sk-lf-renopilot-local
LANGFUSE_BASE_URL=http://localhost:3000

# Langfuse login, created on first start (http://localhost:3000)
# LANGFUSE_INIT_USER_EMAIL=dev@renopilot.local
# LANGFUSE_INIT_USER_PASSWORD=renopilot-local

# Langfuse server secrets: local-dev defaults live in docker-compose.yml, and every port is bound to
# 127.0.0.1. Set your own before first start if anyone else can reach this machine.
# NEXTAUTH_SECRET=
# SALT=
# ENCRYPTION_KEY=                 # openssl rand -hex 32
# CLICKHOUSE_PASSWORD=
# MINIO_ROOT_PASSWORD=
# REDIS_AUTH=

# ---------------------------------------------------------------- tests
# Set to 1 to let pytest run tests that call the real model
# RENOPILOT_LIVE=0
